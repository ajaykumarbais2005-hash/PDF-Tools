{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pdf-tools-api.onrender.com/api/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "https://pdf-tools-api.onrender.com/download/:path*"
    },
    {
      "source": "/brand-icon",
      "destination": "https://pdf-tools-api.onrender.com/brand-icon"
    },
    {
      "source": "/login",
      "destination": "/auth.html"
    },
    {
      "source": "/register",
      "destination": "/auth.html"
    },
    {
      "source": "/setup",
      "destination": "/auth.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
